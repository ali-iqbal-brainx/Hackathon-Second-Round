{
  "manifest_version": 3,
  "name": "Focus Mode Activator",
  "version": "1.0.0",
  "description": "Silence notifications during focus sessions and report interruption attempts",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "alarms", "contentSettings", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/background.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Focus Mode Activator",
    "default_icon": {
      "16": "public/icons/icon-off.png",
      "48": "public/icons/icon-off.png",
      "128": "public/icons/icon-off.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.ts"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "commands": {
    "toggle-focus": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Toggle Focus Mode"
    }
  },
  "icons": {
    "16": "public/icons/icon-off.png",
    "48": "public/icons/icon-off.png",
    "128": "public/icons/icon-off.png"
  }
}
