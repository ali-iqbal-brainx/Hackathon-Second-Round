# HTTP port (default in code is 4000 if omitted)
PORT=4000

# Node environment
NODE_ENV=development

# MongoDB connection string (required for persistence)
MONGO_URI=mongodb://127.0.0.1:27017/briefai

# OpenAI (required for brief analysis and ticket generation)
API_KEY=sk-your-openai-api-key-here
MODEL=gpt-4o-mini
